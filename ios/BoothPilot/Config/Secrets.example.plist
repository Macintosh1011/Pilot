<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to `Secrets.plist` (same folder) and fill in the OpenAI key to enable the
  Phase 2 voice loop. Secrets.plist is gitignored. With no key the booth runs scripted Phase 1
  (UI + live Convex backend). Non-secret backend URLs live in Info.plist / BoothConfig, not here.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>OPENAI_API_KEY</key>
    <string></string>
</dict>
</plist>
