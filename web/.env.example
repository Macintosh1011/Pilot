# Copy this file to .env.local and fill in the values below.
# Every var is NEXT_PUBLIC_* by design — these are browser-safe (no secrets).

# Convex deployment URL — the SAME shared backend as dashboard/ and iOS.
# Required for live data (sessions, demo state, badges). When empty the app
# renders a "Connect Convex" setup card instead of the booth.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Vapi browser SDK public key — enables live mic/voice in the browser.
# If unset (empty), the app falls back to the scripted demo (no microphone).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key

# Logical device id reported to Convex for this booth instance. Defaults to web-1.
NEXT_PUBLIC_DEVICE_ID=web-1

# Optional. Base URL used to build the shareable badge QR link.
# Falls back to the browser's window.location.origin when empty.
NEXT_PUBLIC_BADGE_BASE_URL=https://your-web-app.example.com
